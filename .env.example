# DATABASE_URL: Neon PostgreSQL connection string
# Get this from Neon.tech Dashboard (Connection String section)
DATABASE_URL="postgresql://[user]:[password]@[host]/[dbname]?sslmode=require"

# JWT_SECRET: Secret key for signing login tokens
# Use the random value I generated for you:
JWT_SECRET="dc6844e5ce787ed932fec89185d187ef305fb7c1e426e80e556d61a931960b8b"

# GEMINI_API_KEY: Required for AI features
# Use the same key you used in AI Studio
GEMINI_API_KEY="your-gemini-key-here"

# APP_URL: The URL of your Vercel deployment (e.g., https://daydeals.vercel.app)
APP_URL="https://daydeals.vercel.app"
