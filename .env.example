# DATABASE_URL: Supabase PostgreSQL connection string (Option 2: Direct or Pooler Connection)
# Get this from Supabase Dashboard (Project Settings -> Database -> Connection Strings -> URI)
# Remember to append ?sslmode=require if needed
DATABASE_URL="postgresql://postgres:[password]@[db-host]:6543/postgres?sslmode=require"

# JWT_SECRET: Secret key for signing login tokens
# Use the random value I generated for you:
JWT_SECRET="dc6844e5ce787ed932fec89185d187ef305fb7c1e426e80e556d61a931960b8b"

# GEMINI_API_KEY: Required for AI features
# Use the same key you used in AI Studio
GEMINI_API_KEY="your-gemini-key-here"

# APP_URL: The URL of your Vercel deployment (e.g., https://daydeals.vercel.app)
APP_URL="https://daydeals.vercel.app"

# TELEGRAM_BOT_TOKEN: Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: The chat ID where notifications should be sent
TELEGRAM_CHAT_ID=""
